{
	"manifest_version": 3,
	"name": "KMITL Schedule Builder",
	"version": "0.2.0",
	"description": "Unofficial timetable builder for KMITL registration class data.",
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_title": "KMITL Schedule Builder",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"permissions": ["storage"],
	"content_scripts": [
		{
			"matches": ["https://regis.reg.kmitl.ac.th/*"],
			"js": ["src/content.js"],
			"run_at": "document_idle"
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["src/style.css"],
			"matches": ["https://regis.reg.kmitl.ac.th/*"]
		}
	]
}
